---
// AgenticWorkflowInspector.astro
// Interactive visual step-through and production telemetry for the Dispatcher-Specialist Agent ecosystem
---

<div class="agentic-inspector" id="agentic-inspector" data-initialized="false">
    <div class="inspector-header">
        <div class="inspector-title-area">
            <span class="inspector-badge">LIVE_TELEMETRY</span>
            <h3>Agentic Orchestration Pipeline</h3>
            <span class="system-version">v2.4 // DISPATCHER-SPECIALIST ARCHITECTURE</span>
        </div>
        <div class="inspector-actions">
            <button id="sim-run-btn" class="sim-btn" aria-label="Simulate Agentic Pipeline Run">
                <span class="sim-icon">▶</span>
                <span class="sim-label">RUN_PIPELINE_SIMULATION</span>
                <span class="sim-spinner"></span>
            </button>
        </div>
    </div>

    <!-- Pipeline Visual Nodes -->
    <div class="pipeline-track">
        <div class="pipeline-node active" data-step="1" id="node-1">
            <div class="node-indicator">
                <span class="node-num">01</span>
                <span class="node-pulse"></span>
            </div>
            <div class="node-info">
                <h4>Event Ingestion</h4>
                <p>Webhook Gating & Auth</p>
                <span class="node-file">issues / PR comments</span>
            </div>
        </div>

        <div class="pipeline-connector" id="connector-1">
            <div class="connector-line"></div>
            <div class="connector-packet"></div>
        </div>

        <div class="pipeline-node" data-step="2" id="node-2">
            <div class="node-indicator">
                <span class="node-num">02</span>
                <span class="node-pulse"></span>
            </div>
            <div class="node-info">
                <h4>Gemini Dispatcher</h4>
                <p>Intent Routing & Token Mint</p>
                <span class="node-file">gemini-dispatch.yml</span>
            </div>
        </div>

        <div class="pipeline-connector" id="connector-2">
            <div class="connector-line"></div>
            <div class="connector-packet"></div>
        </div>

        <div class="pipeline-node" data-step="3" id="node-3">
            <div class="node-indicator">
                <span class="node-num">03</span>
                <span class="node-pulse"></span>
            </div>
            <div class="node-info">
                <h4>Specialist Execution</h4>
                <p>Autonomous Sub-Agents</p>
                <span class="node-file">triage / review / plan</span>
            </div>
        </div>

        <div class="pipeline-connector" id="connector-3">
            <div class="connector-line"></div>
            <div class="connector-packet"></div>
        </div>

        <div class="pipeline-node" data-step="4" id="node-4">
            <div class="node-indicator">
                <span class="node-num">04</span>
                <span class="node-pulse"></span>
            </div>
            <div class="node-info">
                <h4>MCP & Quality Gate</h4>
                <p>AST Validation & PR Delivery</p>
                <span class="node-file">MCP Tools / AST Gates</span>
            </div>
        </div>
    </div>

    <!-- Interactive Step Deep-Dive Pane -->
    <div class="node-details-card" id="node-details-card">
        <div class="details-header">
            <div class="details-tab-title" id="details-step-title">[01. EVENT INGESTION & PERMISSION GATING]</div>
            <div class="details-meta" id="details-step-meta">TRIGGER: Webhook Event | GATING: OWNER / MEMBER / COLLABORATOR</div>
        </div>
        <div class="details-body" id="details-step-body">
            <div class="details-col">
                <h5>Operational Mechanics</h5>
                <p id="details-mechanics">
                    Listens for GitHub issue creation, PR reviews, or collaborative triggers like <code>@gemini-cli /plan-execute</code>. Enforces cryptographic identity verification by minting ephemeral GitHub App installation tokens before execution.
                </p>
            </div>
            <div class="details-col">
                <h5>Data Contract & Security</h5>
                <pre id="details-payload" class="details-code"><code>{`{
  "event": "issue_comment.created",
  "sender_permission": "OWNER",
  "token_scope": ["issues:write", "pull_requests:write"],
  "command": "plan-execute"
}`}</code></pre>
            </div>
        </div>
    </div>

    <!-- Live Execution Terminal Log -->
    <div class="sim-terminal-wrap">
        <div class="terminal-bar">
            <div class="terminal-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
            </div>
            <span class="terminal-session-title">AGENTIC_RUNNER_CONSOLE // DISPATCHER_STREAM</span>
            <button id="clear-sim-btn" class="terminal-clear-btn" aria-label="Clear Terminal Logs">CLEAR</button>
        </div>
        <pre class="sim-terminal-output" id="sim-terminal-output">// Pipeline standby. Click [RUN_PIPELINE_SIMULATION] to observe real-time agent dispatch and MCP tool execution.</pre>
    </div>

    <!-- Production Telemetry & Eval Scorecard -->
    <div class="telemetry-grid">
        <div class="telemetry-card">
            <div class="telemetry-label">Triage Precision</div>
            <div class="telemetry-value">96.4%</div>
            <div class="telemetry-desc">Autonomous label & severity accuracy across test suite</div>
        </div>
        <div class="telemetry-card">
            <div class="telemetry-label">Avg Plan-to-PR Time</div>
            <div class="telemetry-value">2m 14s</div>
            <div class="telemetry-desc">From comment trigger to verified branch & Pull Request</div>
        </div>
        <div class="telemetry-card">
            <div class="telemetry-label">Quality Gate Pass Rate</div>
            <div class="telemetry-value">100%</div>
            <div class="telemetry-desc">Zero breaking type regressions (gated by strict AST checks)</div>
        </div>
        <div class="telemetry-card">
            <div class="telemetry-label">Token Caching Savings</div>
            <div class="telemetry-value">68%</div>
            <div class="telemetry-desc">Reduced prompt token overhead via cached system manifests</div>
        </div>
    </div>
</div>

<style>
    .agentic-inspector {
        background: #020202;
        border: 1px solid var(--border-color);
        padding: 2rem;
        margin: 2.5rem 0;
        box-shadow: 0 0 25px rgba(0, 255, 65, 0.08);
        font-family: 'JetBrains Mono', monospace;
    }

    .inspector-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .inspector-badge {
        display: inline-block;
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--accent-color);
        background: rgba(0, 255, 65, 0.1);
        padding: 0.2rem 0.5rem;
        border: 1px solid var(--accent-color);
        margin-bottom: 0.5rem;
        letter-spacing: 0.1em;
    }

    .inspector-title-area h3 {
        margin: 0 0 0.4rem 0;
        font-size: 1.5rem;
        color: var(--text-color);
        letter-spacing: -0.01em;
    }

    .system-version {
        font-size: 0.75rem;
        color: var(--secondary-text);
        letter-spacing: 0.05em;
    }

    .sim-btn {
        background: #002600;
        border: 1px solid var(--accent-color);
        color: var(--accent-color);
        padding: 0.6rem 1.25rem;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s ease;
        text-transform: uppercase;
        box-shadow: 0 0 10px rgba(0, 255, 65, 0.2);
    }

    .sim-btn:hover:not(:disabled) {
        background: var(--accent-color);
        color: #020202;
        box-shadow: 0 0 20px rgba(0, 255, 65, 0.5);
    }

    .sim-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .sim-spinner {
        display: none;
        width: 12px;
        height: 12px;
        border: 2px solid transparent;
        border-top-color: currentColor;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .sim-btn.loading .sim-spinner {
        display: inline-block;
    }
    .sim-btn.loading .sim-icon {
        display: none;
    }

    @keyframes spin {
        100% { transform: rotate(360deg); }
    }

    /* Pipeline Track */
    .pipeline-track {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
        overflow-x: auto;
        padding-bottom: 1rem;
    }

    .pipeline-node {
        background: rgba(0, 38, 0, 0.2);
        border: 1px solid var(--border-color);
        padding: 1.25rem 1rem;
        cursor: pointer;
        transition: all 0.25s ease;
        position: relative;
        min-width: 140px;
    }

    .pipeline-node:hover {
        border-color: var(--accent-color);
        transform: translateY(-2px);
    }

    .pipeline-node.active {
        border-color: var(--accent-color);
        background: rgba(0, 255, 65, 0.08);
        box-shadow: 0 0 15px rgba(0, 255, 65, 0.25);
    }

    .pipeline-node.running {
        border-color: #00ff41;
        box-shadow: 0 0 25px rgba(0, 255, 65, 0.5);
        animation: nodePulse 1.2s infinite;
    }

    @keyframes nodePulse {
        0%, 100% { border-color: var(--accent-color); }
        50% { border-color: #ffffff; }
    }

    .node-indicator {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .node-num {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--accent-color);
    }

    .node-pulse {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--secondary-text);
        transition: all 0.3s ease;
    }

    .pipeline-node.active .node-pulse {
        background: var(--accent-color);
        box-shadow: 0 0 8px var(--accent-color);
    }

    .node-info h4 {
        margin: 0 0 0.25rem 0;
        font-size: 0.85rem;
        color: var(--text-color);
        font-weight: 700;
    }

    .node-info p {
        margin: 0 0 0.5rem 0;
        font-size: 0.7rem;
        color: var(--secondary-text);
        line-height: 1.3;
    }

    .node-file {
        font-size: 0.65rem;
        color: var(--accent-color);
        background: rgba(0, 0, 0, 0.4);
        padding: 0.15rem 0.35rem;
        border: 1px solid rgba(0, 255, 65, 0.2);
        display: inline-block;
    }

    .pipeline-connector {
        display: flex;
        align-items: center;
        width: 28px;
        position: relative;
    }

    .connector-line {
        width: 100%;
        height: 2px;
        background: var(--border-color);
        transition: background 0.3s ease;
    }

    .pipeline-connector.active .connector-line {
        background: var(--accent-color);
        box-shadow: 0 0 6px var(--accent-color);
    }

    .connector-packet {
        display: none;
        position: absolute;
        width: 6px;
        height: 6px;
        background: #ffffff;
        border-radius: 50%;
        box-shadow: 0 0 8px #00ff41;
        animation: packetTravel 0.6s linear infinite;
    }

    .pipeline-connector.running .connector-packet {
        display: block;
    }

    @keyframes packetTravel {
        0% { left: 0; opacity: 0; }
        50% { opacity: 1; }
        100% { left: 100%; opacity: 0; }
    }

    /* Node Details Card */
    .node-details-card {
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid var(--border-color);
        padding: 1.5rem;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        border-bottom: 1px solid rgba(0, 255, 65, 0.15);
        padding-bottom: 0.75rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .details-tab-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--accent-color);
    }

    .details-meta {
        font-size: 0.7rem;
        color: var(--secondary-text);
    }

    .details-body {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .details-col h5 {
        margin: 0 0 0.5rem 0;
        font-size: 0.75rem;
        color: var(--secondary-text);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .details-col p {
        margin: 0;
        font-size: 0.85rem;
        color: #d1d5db;
        line-height: 1.6;
    }

    .details-code {
        margin: 0;
        background: #000000;
        border: 1px solid #1a1a1a;
        padding: 0.75rem;
        font-size: 0.75rem;
        color: var(--accent-color);
        max-height: 140px;
        overflow-y: auto;
    }

    /* Simulation Terminal Output */
    .sim-terminal-wrap {
        background: #000000;
        border: 1px solid var(--border-color);
        margin-bottom: 2rem;
    }

    .terminal-bar {
        background: #050505;
        border-bottom: 1px solid #1a1a1a;
        padding: 0.4rem 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .terminal-dots {
        display: flex;
        gap: 6px;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }
    .dot.red { background: #ff5f56; }
    .dot.yellow { background: #ffbd2e; }
    .dot.green { background: #27c93f; }

    .terminal-session-title {
        font-size: 0.65rem;
        color: var(--secondary-text);
        letter-spacing: 0.05em;
    }

    .terminal-clear-btn {
        background: none;
        border: 1px solid #333;
        color: #666;
        font-size: 0.55rem;
        padding: 0.15rem 0.4rem;
        cursor: pointer;
        font-family: inherit;
    }

    .terminal-clear-btn:hover {
        border-color: var(--accent-color);
        color: var(--accent-color);
    }

    .sim-terminal-output {
        margin: 0;
        padding: 1rem;
        font-size: 0.75rem;
        line-height: 1.6;
        color: var(--accent-color);
        white-space: pre-wrap;
        word-break: break-all;
        min-height: 120px;
        max-height: 240px;
        overflow-y: auto;
    }

    /* Telemetry Grid */
    .telemetry-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
    }

    .telemetry-card {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid var(--border-color);
        padding: 1.25rem 1rem;
        text-align: center;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .telemetry-card:hover {
        border-color: var(--accent-color);
        transform: translateY(-2px);
    }

    .telemetry-label {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--secondary-text);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .telemetry-value {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--accent-color);
        text-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
        margin-bottom: 0.5rem;
    }

    .telemetry-desc {
        font-size: 0.65rem;
        color: #888888;
        line-height: 1.4;
    }

    @media (max-width: 900px) {
        .pipeline-track {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
        .pipeline-connector {
            width: 2px;
            height: 20px;
            margin: 0 auto;
        }
        .connector-line {
            width: 2px;
            height: 100%;
        }
        .details-body {
            grid-template-columns: 1fr;
        }
        .telemetry-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 540px) {
        .telemetry-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    const stepData: Record<number, {
        title: string;
        meta: string;
        mechanics: string;
        payload: string;
    }> = {
        1: {
            title: "[01. EVENT INGESTION & PERMISSION GATING]",
            meta: "TRIGGER: Webhook Event | GATING: OWNER / MEMBER / COLLABORATOR",
            mechanics: "Listens for repository webhooks: issue creation, pull request submissions, or comment directives (@gemini-cli /plan-execute). Verifies cryptographic permissions and mints an ephemeral GitHub App token with granular write permissions.",
            payload: `{\n  "event": "issue_comment.created",\n  "sender_permission": "OWNER",\n  "token_scope": ["issues:write", "pull_requests:write"],\n  "command": "plan-execute"\n}`
        },
        2: {
            title: "[02. GEMINI DISPATCHER ROUTING]",
            meta: "WORKFLOW: gemini-dispatch.yml | ENGINE: actions/github-script",
            mechanics: "The Dispatcher inspects the normalized intent, parses natural language parameters, extracts repository file context, and dispatches the execution target to specialized downstream workflows (triage, review, or plan-execute).",
            payload: `{\n  "dispatch_target": "gemini-plan-execute.yml",\n  "issue_number": 42,\n  "context_files": ["src/content.config.ts"],\n  "model": "gemini-2.5-pro"\n}`
        },
        3: {
            title: "[03. SPECIALIST AGENT ORCHESTRATION]",
            meta: "ROLE: Plan-Execute Specialist | SYSTEM PROMPT: AGENTS.md Protocol",
            mechanics: "The specialist spins up with repository rules and skill templates (.gemini/skills/). It reasons through edge cases, defines atomic changes, creates a dedicated git branch, and prepares the implementation diff.",
            payload: `{\n  "specialist": "plan-execute",\n  "branch": "gemini/feature-issue-42",\n  "planned_steps": 3,\n  "cache_tokens": 4200\n}`
        },
        4: {
            title: "[04. MCP BRIDGE & QUALITY GATES]",
            meta: "PROTOCOL: Model Context Protocol | GATE: Strict TypeScript & AST",
            mechanics: "Agent interacts directly via Model Context Protocol (MCP) tool calls. Executes automated diagnostics (npm run check, npm run build). Once zero errors are confirmed, it commits changes and opens an annotated Pull Request.",
            payload: `{\n  "mcp_tools_invoked": ["write_to_file", "run_check"],\n  "diagnostics": "0 errors, 0 warnings",\n  "pr_status": "OPEN (#43)",\n  "verified": true\n}`
        }
    };

    function initAgenticInspector() {
        const root = document.getElementById('agentic-inspector');
        if (!root || root.getAttribute('data-initialized') === 'true') return;
        root.setAttribute('data-initialized', 'true');

        const nodes = root.querySelectorAll<HTMLElement>('.pipeline-node');
        const connectors = root.querySelectorAll<HTMLElement>('.pipeline-connector');
        const titleEl = document.getElementById('details-step-title');
        const metaEl = document.getElementById('details-step-meta');
        const mechanicsEl = document.getElementById('details-mechanics');
        const payloadEl = document.getElementById('details-payload');
        const simBtn = document.getElementById('sim-run-btn') as HTMLButtonElement;
        const clearBtn = document.getElementById('clear-sim-btn');
        const terminalOut = document.getElementById('sim-terminal-output');

        const selectStep = (stepNum: number) => {
            nodes.forEach(n => {
                const s = parseInt(n.dataset.step || '0', 10);
                n.classList.toggle('active', s === stepNum);
            });

            connectors.forEach((c, idx) => {
                c.classList.toggle('active', idx < stepNum - 1);
            });

            const data = stepData[stepNum];
            if (data && titleEl && metaEl && mechanicsEl && payloadEl) {
                titleEl.textContent = data.title;
                metaEl.textContent = data.meta;
                mechanicsEl.textContent = data.mechanics;
                payloadEl.innerHTML = `<code>${data.payload}</code>`;
            }
        };

        nodes.forEach(n => {
            n.addEventListener('click', () => {
                const s = parseInt(n.dataset.step || '1', 10);
                selectStep(s);
            });
        });

        clearBtn?.addEventListener('click', () => {
            if (terminalOut) {
                terminalOut.textContent = '// Terminal cleared. Standby.';
            }
        });

        // Simulation runner
        simBtn?.addEventListener('click', async () => {
            if (simBtn.disabled) return;
            simBtn.disabled = true;
            simBtn.classList.add('loading');

            if (terminalOut) terminalOut.textContent = '';

            const appendLog = (line: string) => {
                if (!terminalOut) return;
                const now = new Date().toISOString().substring(11, 19);
                terminalOut.textContent += `[${now}] ${line}\n`;
                terminalOut.scrollTop = terminalOut.scrollHeight;
            };

            const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));

            try {
                // Step 1
                selectStep(1);
                const node1 = document.getElementById('node-1');
                node1?.classList.add('running');
                appendLog('INGEST // Webhook received: issue_comment.created on Issue #42');
                appendLog('AUTH   // Validating author association: OWNER (access granted)');
                appendLog('TOKEN  // Minting ephemeral GitHub App token with scoped write access...');
                await sleep(700);
                node1?.classList.remove('running');
                const conn1 = document.getElementById('connector-1');
                conn1?.classList.add('running');

                // Step 2
                selectStep(2);
                const node2 = document.getElementById('node-2');
                node2?.classList.add('running');
                appendLog('ROUTE  // gemini-dispatch.yml triggered');
                appendLog('PARSE  // Extracted command directive: @gemini-cli /plan-execute');
                appendLog('DISPATCH // Routing to specialist workflow: gemini-plan-execute.yml');
                await sleep(800);
                conn1?.classList.remove('running');
                node2?.classList.remove('running');
                const conn2 = document.getElementById('connector-2');
                conn2?.classList.add('running');

                // Step 3
                selectStep(3);
                const node3 = document.getElementById('node-3');
                node3?.classList.add('running');
                appendLog('SPECIALIST // Plan-Execute Agent instantiated with Gemini 2.5 Pro');
                appendLog('PROMPT // Reading AGENTS.md rules & system-design-architect skill');
                appendLog('REASON // Deconstructing request into 3 atomic implementation phases');
                appendLog('BRANCH // Created isolated worktree: gemini/feature-issue-42');
                await sleep(900);
                conn2?.classList.remove('running');
                node3?.classList.remove('running');
                const conn3 = document.getElementById('connector-3');
                conn3?.classList.add('running');

                // Step 4
                selectStep(4);
                const node4 = document.getElementById('node-4');
                node4?.classList.add('running');
                appendLog('MCP    // Invoking MCP Tool: write_to_file (src/content.config.ts)');
                appendLog('VERIFY // Running quality gate: npm run check');
                appendLog('CHECK  // TypeScript diagnostics: 0 errors, 0 warnings');
                appendLog('VERIFY // Running quality gate: npm run build (SSG output verified)');
                appendLog('PR     // Opened Pull Request #43 with automated summary and test traces');
                appendLog('STATUS // Pipeline cycle completed successfully in 2.4s. All checks passed.');
                await sleep(800);
                conn3?.classList.remove('running');
                node4?.classList.remove('running');

            } finally {
                simBtn.disabled = false;
                simBtn.classList.remove('loading');
            }
        });
    }

    document.addEventListener('astro:page-load', initAgenticInspector);
</script>
